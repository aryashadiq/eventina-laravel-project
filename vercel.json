{
    "version": 2,
    "regions": ["hnd1"],
    "builds": [
        { "src": "api/index.php", "use": "vercel-php@0.7.4" },
        { "src": "public/**", "use": "@vercel/static" }
    ],
    "routes": [
        { "src": "/(css|js|img|fonts)/(.*)", "dest": "/public/$1/$2" },
        { "src": "/(favicon\\.ico|robots\\.txt)", "dest": "/public/$1" },
        { "src": "/(.*)", "dest": "/api/index.php" }
    ]
}
